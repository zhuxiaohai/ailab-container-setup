# 仓库内置默认值（可提交 Git，不含密钥）
# 环境相关配置请复制 config.local.env.example -> config.local.env 后修改（已 gitignore）

CONTAINER_SETUP_ROOT=/workspace/ailab-container-setup
WORKSPACE_SECRETS=/workspace

DOCKER_NETWORK=docker_network

VOL_WORKSPACE_HOST=/mnt/remotedisk_ailab_node1/zhuxiaohai
VOL_DATA_HOST=/mnt/remotedisk_ailab_common
VOL_MODEL_HOST=/mnt/remotedisk_ailab_node1/model_space

VOL_WORKSPACE=/workspace
VOL_DATA=/data
VOL_MODEL=/model

# 额外挂载（launch-container.sh）：分号分隔 host:container，或见 config.extra-volumes
DOCKER_EXTRA_VOLUMES=

# SSH（ssh-config-auto.py）
# launch 会把启动参数里的 IP 写入 CONTAINER_IP 并传入容器。
# SSH_PORT 非空则固定使用该端口；留空且有 CONTAINER_IP 时用 SSH_PORT_BASE+IP末段；否则用 SSH_FALLBACK_PORT。
SSH_PORT_BASE=20000
SSH_PORT=
SSH_FALLBACK_PORT=22
ROOT_PASSWORD=
CONTAINER_IP=
REDIRECT_PYTHON=

# Clash
CLASH_DIR=/etc/clash
CLASH_BIN=/usr/local/clash
CLASH_PORT=7890
CLASH_SUBLINK=
CLASH_DOWNLOAD_BASE=

CONTAINER_ENV_FILE=/workspace/.container.env
PROXY_STATE_FILE=/workspace/.proxy_state
CLASH_RUN_STATE_FILE=/etc/clash/.run_state

AUTO_SSH=1
AUTO_CLASH=1
AUTO_PROXY_BASHRC=1
