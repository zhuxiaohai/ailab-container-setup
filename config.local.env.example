# 复制为本机/本环境配置（勿提交 Git）：
#   cp config.local.env.example config.local.env
# 由 lib/common.sh 自动加载（在 config.defaults.env 之后，同名变量覆盖默认值）
#
# 改这一份即可，无需每次 export；launch / configure / 容器内脚本都会读到。

# ---------- 仓库与敏感文件目录 ----------
CONTAINER_SETUP_ROOT="/workspace/ailab-container-setup"
WORKSPACE_SECRETS="/workspace"

# ---------- Docker（宿主机 launch 用）----------
DOCKER_NETWORK="docker_network"
VOL_WORKSPACE_HOST="/mnt/remotedisk_ailab_node1/zhuxiaohai"
VOL_DATA_HOST="/mnt/remotedisk_ailab_common"
VOL_MODEL_HOST="/mnt/remotedisk_ailab_node1/model_space"

# 额外挂载（任选其一或组合）：
#   A) 本行分号分隔：DOCKER_EXTRA_VOLUMES="/mnt/local_ssd_550/zhuxiaohai:/fast"
#   B) 复制 config.extra-volumes.example -> config.extra-volumes，每行一条
# DOCKER_EXTRA_VOLUMES="/mnt/local_ssd_550/zhuxiaohai:/fast"

# ---------- Clash（xcjs）----------
# 订阅链接（xcjs 官网复制，一行）
CLASH_SUBLINK="https://你的-clash-订阅链接"
# 下载节点基址（与 xcjs linux 脚本一致，用于拉 Clash 二进制与 mmdb）
CLASH_DOWNLOAD_BASE="https://你的xcjs下载节点"
CLASH_PORT="7890"

# ---------- SSH（ssh-config-auto.py / run-ssh-config.sh）----------
# launch <image> <name> <ip> 时：宿主机把 <ip> 作为 CONTAINER_IP 传入容器（与 --ip 一致）。
# SSH_PORT 写死则所有容器都用该端口（多容器固定 IP 时通常用 22 即可）。
# SSH_PORT 留空且有 CONTAINER_IP 时：端口 = SSH_PORT_BASE + IP 末段（如 10.20.20.53 -> 20053）。
SSH_PORT="22"
SSH_PORT_BASE="20000"
SSH_FALLBACK_PORT="22"
# CONTAINER_IP=""          # launch/configure 会传入；仅容器内手动跑脚本时留空则用 hostname -I
# ROOT_PASSWORD=""         # 留空：随机 8 位；写死则固定 root 密码
# REDIRECT_PYTHON=""       # 仅 yes/y 时重定向 python 到 conda

# ---------- 状态文件路径（一般不用改）----------
# CONTAINER_ENV_FILE="${WORKSPACE_SECRETS}/.container.env"
# PROXY_STATE_FILE="${WORKSPACE_SECRETS}/.proxy_state"
# CLASH_RUN_STATE_FILE="/etc/clash/.run_state"

# ---------- 自动化开关（命令行临时覆盖仍生效，如 AUTO_SSH=0 bash setup-inside-container.sh）----------
AUTO_SSH=1
AUTO_CLASH=1
AUTO_PROXY_BASHRC=1

# ---------- 仅 launch 时可选 ----------
# SKIP_SETUP="0"
